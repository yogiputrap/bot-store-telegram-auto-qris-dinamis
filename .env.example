# Telegram Bot Credentials
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
OWNER_ID=YOUR_TELEGRAM_USER_ID_HERE
ADMIN_IDS=YOUR_TELEGRAM_USER_ID_HERE

# Store Identity
STORE_NAME=Moakun Store
STORE_USERNAME=moakun_bot
CHANNEL_ID=-100xxxxxxxxxx
CHANNEL_URL=https://t.me/yourchannel
GROUP_URL=https://t.me/yourgroup
SUPPORT_USERNAME=yopratama
BANNER_URL=assets/moakun_banner.jpg

# CodeGatra Auto QRIS Payment Gateway (pay.codegatra.com)
CODEGATRA_BASE_URL=https://pay.codegatra.com/api
CODEGATRA_API_KEY=YOUR_CODEGATRA_API_KEY_HERE
CODEGATRA_NAMA_PROJECT=YOUR_PROJECT_NAME_HERE
CODEGATRA_EXPIRED_MINUTES=10

# RumahOTP Virtual SMS Service (rumahotp.io)
RUMAHOTP_API_KEY=YOUR_RUMAHOTP_API_KEY_HERE
RUMAHOTP_BASE_URL=https://www.rumahotp.io
OTP_PROFIT_MARGIN=1500

# General Bot Settings
CURRENCY=Rp
MIN_DEPOSIT=10000
ITEMS_PER_PAGE=5
AUTO_BACKUP_HOURS=24
